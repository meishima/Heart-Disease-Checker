<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="300"
        x:Class="HeartDiseaseChecker.DatasetWindow"
        Title="DatasetWindow"
        Width="600" Height="300">
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Dataset Calculations" FontSize="20" HorizontalAlignment="Center"/>
        <StackPanel>                      
            <DataGrid Name="ModelGrid" 
                x:CompileBindings="False" 
                Height="200" 
                IsReadOnly="True" 
                GridLinesVisibility="All"
                BorderThickness="1" 
                BorderBrush="Gray">
                              
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Algorithm" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Accuracy" Binding="{Binding Accuracy}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </StackPanel>
</Window>